{
  "name": "medshare-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "db:up": "docker compose -f ../docker-compose.yml --env-file ../.env up -d --wait",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "db:reset": "tsx scripts/db.ts reset",
    "db:test": "tsx scripts/db.ts test",
    "typecheck": "tsc --noEmit",
    "prisma:pull": "tsx scripts/prisma.ts db pull",
    "prisma:generate": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "perf:build": "tsx scripts/perf.ts build",
    "perf:explain": "tsx scripts/perf.ts explain"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vitest": "^3.2.7"
  }
}
