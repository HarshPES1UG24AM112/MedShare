{
  "name": "medshare-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "db:up": "docker compose -f ../docker-compose.yml --env-file ../.env up -d --wait",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "db:reset": "tsx scripts/db.ts reset",
    "db:test": "tsx scripts/db.ts test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3"
  }
}
