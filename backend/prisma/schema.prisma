/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model expiry_alerts {
  id                    BigInt       @id @default(autoincrement())
  inventory_id          BigInt
  level                 expiry_level
  status                alert_status @default(OPEN)
  quantity_at_detection Int
  detected_at           DateTime     @default(dbgenerated("fn_now()")) @db.Timestamptz(6)
  acknowledged_by       BigInt?
  acknowledged_at       DateTime?    @db.Timestamptz(6)
  resolved_at           DateTime?    @db.Timestamptz(6)
  users                 users?       @relation(fields: [acknowledged_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  inventory             inventory    @relation(fields: [inventory_id], references: [id], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model facilities {
  id                                                                      Int                              @id @default(autoincrement())
  organization_id                                                         Int
  region_id                                                               Int
  code                                                                    String                           @unique
  name                                                                    String
  facility_type                                                           facility_type
  address_line                                                            String
  latitude                                                                Decimal                          @db.Decimal(9, 6)
  longitude                                                               Decimal                          @db.Decimal(9, 6)
  has_cold_chain                                                          Boolean                          @default(false)
  max_dispatch_radius_km                                                  Decimal                          @default(100) @db.Decimal(6, 1)
  contact_phone                                                           String?
  is_active                                                               Boolean                          @default(true)
  is_synthetic                                                            Boolean                          @default(true)
  created_at                                                              DateTime                         @default(dbgenerated("fn_now()")) @db.Timestamptz(6)
  updated_at                                                              DateTime                         @default(dbgenerated("fn_now()")) @db.Timestamptz(6)
  audit_logs                                                              audit_logs[]
  organizations                                                           organizations                    @relation(fields: [organization_id], references: [id], onUpdate: NoAction)
  regions                                                                 regions                          @relation(fields: [region_id], references: [id], onUpdate: NoAction)
  facility_medicine_settings                                              facility_medicine_settings[]
  facility_users                                                          facility_users[]
  inventory                                                               inventory[]
  redistribution_recommendations                                          redistribution_recommendations[]
  stock_requests                                                          stock_requests[]
  transfer_requests_transfer_requests_destination_facility_idTofacilities transfer_requests[]              @relation("transfer_requests_destination_facility_idTofacilities")
  transfer_requests_transfer_requests_source_facility_idTofacilities      transfer_requests[]              @relation("transfer_requests_source_facility_idTofacilities")

  @@unique([organization_id, name])
  @@index([organization_id], map: "ix_facilities_org")
  @@index([region_id], map: "ix_facilities_region")
}

