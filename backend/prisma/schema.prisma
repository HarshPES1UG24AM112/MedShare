generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model audit_logs {
  id            BigInt      @id @default(autoincrement())
  occurred_at   DateTime    @default(dbgenerated("fn_now()")) @db.Timestamptz(6)
  actor_user_id BigInt?
  action        String
  entity_type   String
  entity_id     String?
  facility_id   Int?
  old_values    Json?
  new_values    Json?
  request_id    String?     @db.Uuid
  ip_address    String?     @db.Inet
  users         users?      @relation(fields: [actor_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  facilities    facilities? @relation(fields: [facility_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([actor_user_id, occurred_at(sort: Desc)], map: "ix_audit_actor_time")
  @@index([entity_type, entity_id], map: "ix_audit_entity")
  @@index([occurred_at], map: "ix_audit_occurred_brin", type: Brin)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
