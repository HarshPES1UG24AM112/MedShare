model engine_config {
  id                               Boolean  @id @default(true)
  planning_horizon_days            Int      @default(30)
  min_remaining_shelf_life_days    Int      @default(14)
  near_expiry_window_days          Int      @default(60)
  measured_demand_min_history_days Int      @default(30)
  large_adjustment_audit_units     Int      @default(500)
  updated_by                       BigInt?
  updated_at                       DateTime @default(now()) @db.Timestamptz(6)
  users                            users?   @relation(fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
