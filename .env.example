# Copy to .env (git-ignored) and change every password.

# --- PostgreSQL container (docker compose) ---
POSTGRES_ADMIN_USER=medshare_admin
POSTGRES_ADMIN_PASSWORD=change-me-admin
POSTGRES_PORT=5433

# --- Neo4j graph database container (docker compose) ---
# Browser UI: http://localhost:7474 (user neo4j). At least 8 characters.
NEO4J_PASSWORD=change-me-neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j

# --- Backend ---
# Superuser connection: used ONLY by the migration / seed / test runner.
DATABASE_ADMIN_URL=postgres://medshare_admin:change-me-admin@localhost:5433/medshare
# Least-privilege application role (created by migrations; password set by the runner).
MEDSHARE_APP_PASSWORD=change-me-app
DATABASE_URL=postgres://medshare_app:change-me-app@localhost:5433/medshare

# --- API (Phase 3) ---
# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret-of-32-plus-chars
JWT_EXPIRES_IN=8h
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Run expiry/shortage/recommendation jobs daily inside the API process
JOBS_ENABLED=false
