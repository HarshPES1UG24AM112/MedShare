# Copy to .env (git-ignored) and change every password.

# --- PostgreSQL container (docker compose) ---
POSTGRES_ADMIN_USER=medshare_admin
POSTGRES_ADMIN_PASSWORD=change-me-admin
POSTGRES_PORT=5433

# --- Backend ---
# Superuser connection: used ONLY by the migration / seed / test runner.
DATABASE_ADMIN_URL=postgres://medshare_admin:change-me-admin@localhost:5433/medshare
# Least-privilege application role (created by migrations; password set by the runner).
MEDSHARE_APP_PASSWORD=change-me-app
DATABASE_URL=postgres://medshare_app:change-me-app@localhost:5433/medshare
